        <Param val="import serial #Import the serial library&amp;#10;#Change 'COM5' here to your serial port address&amp;#10;port = serial.Serial('COM5') &amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
