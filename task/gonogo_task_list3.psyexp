        <Param val="pulse_started = False&amp;#10;pulse_ended = False&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="##triggers for stimuli category&amp;#10;if polygon.status == STARTED and not pulse_started:&amp;#10;    if stim_type == 'go':&amp;#10;        win.callOnFlip(port.write, [2])&amp;#10;    else:&amp;#10;        win.callOnFlip(port.write, [8])&amp;#10;    pulse_start_time = globalClock.getTime()&amp;#10;    pulse_started  = True&amp;#10;        &amp;#10;if pulse_started and not pulse_ended:&amp;#10;    if globalClock.getTime() - pulse_start_time &gt;= 0.005:&amp;#10;        win.callOnFlip(port.write,[0])&amp;#10;        pulse_ended = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((polygon.status === PsychoJS.Status.STARTED) &amp;&amp; (! pulse_started))) {&amp;#10;    if ((stim_type === &quot;go&quot;)) {&amp;#10;        psychoJS.window.callOnFlip(port.write, [2]);&amp;#10;    } else {&amp;#10;        psychoJS.window.callOnFlip(port.write, [8]);&amp;#10;    }&amp;#10;    pulse_start_time = globalClock.getTime();&amp;#10;    pulse_started = true;&amp;#10;}&amp;#10;if ((pulse_started &amp;&amp; (! pulse_ended))) {&amp;#10;    if (((globalClock.getTime() - pulse_start_time) &gt;= 0.005)) {&amp;#10;        psychoJS.window.callOnFlip(port.write, [0]);&amp;#10;        pulse_ended = true;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="port.close()" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="port.close();&amp;#10;" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="trigger_stimuli" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <KeyboardComponent name="key_resp_2" plugin="None">
        <Param val="'space'" valType="list" updates="constant" name="allowedKeys"/>
        <Param val="$corrAnswer" valType="str" updates="constant" name="correctAns"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
